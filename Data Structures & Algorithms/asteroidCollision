class Solution:
    def asteroidCollision(self, asteroids: List[int]) -> List[int]:

        stack = []
        for asteroid in asteroids:
            #collision will only happen when the aster from left --> <---
            #we mark asteriod zero if it is lower than top of the stack
            while stack and asteroid <0 and stack[-1]>0:
                sumTemp= asteroid+stack[-1]
                if sumTemp==0:
                    stack.pop()
                    asteroid=0
                elif sumTemp>0:
                    asteroid=0
                else:
                    stack.pop()

            if asteroid!=0:
                stack.append(asteroid)
        return stack
                    

                
                    


        
